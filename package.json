{
  "name": "@local/dsh-bili-comment-reply",
  "version": "1.2.2",
  "private": true,
  "type": "module",
  "description": "B站角色AI评论助手：根据评论及本机人设生成回复，使用DSH默认模型，无需关键词模板",
  "exports": {
    ".": "./host.js",
    "./host": "./host.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "host.js",
    "index.js",
    "client.js",
    "engine.js",
    "bili-api.js",
    "persona-generator.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CarryM3/-dsh-bili-comment-reply.git"
  },
  "homepage": "https://github.com/CarryM3/-dsh-bili-comment-reply#readme",
  "bugs": {
    "url": "https://github.com/CarryM3/-dsh-bili-comment-reply/issues"
  },
  "scripts": {
    "test": "node --test *.test.js",
    "check": "node --check host.js && node --check index.js && node --check engine.js && node --check client.js && node --check bili-api.js && node --check persona-generator.js"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "zod": "^4.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "devDependencies": {
    "react": "19.2.0",
    "react-test-renderer": "19.2.0"
  }
}
